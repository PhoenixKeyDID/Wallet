# Security trust boundaries — changes to these files require maintainer review.
#
# In a PUBLIC repo the curated dApp allow-list and install links are a phishing
# surface: a look-alike / homoglyph URL merged via a drive-by PR would be
# "blessed" by the wallet's own brand. The Cardano tx / address / key-derivation
# library moves real funds. Any change here must be consciously re-approved.

/src/lib/cardano/connect.ts     @AladinContract
/src/lib/cardano/send.ts        @AladinContract
/src/lib/cardano/tx.ts          @AladinContract
/src/lib/cardano/governance.ts  @AladinContract
/src/lib/cardano/staking.ts     @AladinContract
/src/lib/cardano/address.ts     @AladinContract
/src/lib/cardano/xpub.ts        @AladinContract
/src/lib/cardano/receive.ts     @AladinContract
/src/lib/cardano/qr.ts          @AladinContract
/locales/                       @AladinContract

# The self-custody keystore. These files hold the recovery phrase, the vault
# that encrypts it, and the signing keys derived from it — the only code in the
# repo where a bug loses funds that nobody else is holding for the user.
/src/lib/keystore/                                @AladinContract
/src/components/wallet/LocalWalletPanel.tsx       @AladinContract

# The extension package. `manifest.json` decides which hosts the wallet may
# reach and what may execute inside it; loosening either is a one-line diff.
/extension/                                       @AladinContract

# Files that carry an outbound URL. `scripts/check-urls.mjs` fails CI when an
# absolute URL appears in src/ outside this list, so the two cannot drift: to
# add a URL anywhere else you must add the file here, which pulls in a
# code-owner review. A homoglyph swap (redeem.midnlght.gd) is a one-character
# diff that no reviewer catches by accident.
/src/lib/night.ts                        @AladinContract
/src/lib/cardano/provider.ts             @AladinContract
/src/components/night/NightRedeem.tsx    @AladinContract
/src/lib/cardano/connect.test.ts         @AladinContract
/src/components/wallet/Cip30Panel.tsx    @AladinContract

# The two files a stranger reads first, and the ones a search engine indexes.
# `docs/Phoenix Wallet-Feat.md` names the Midnight redemption portal and two
# dApp hosts; README carries the install instructions. A homoglyph swap here
# reaches more people than one in any source file, and for a long time neither
# was scanned at all.
/README.md                               @AladinContract
/docs/                                   @AladinContract

# The gate itself, and the rules that decide what is gated.
/src/components/wallet/ConfirmGate.tsx   @AladinContract
/.github/                                @AladinContract
/scripts/                                @AladinContract
