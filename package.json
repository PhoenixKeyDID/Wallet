{
  "name": "@phoenixkey/wallet",
  "version": "0.1.0",
  "description": "Phoenix Wallet — a pure-JS Cardano wallet module: use it like a traditional wallet (no DID, seed/keys never leave your device) or with a Phoenix DID in parallel.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./src/lib/node-globals.ts"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:locales": "node scripts/check-locales.mjs",
    "check:host-contract": "node scripts/check-host-contract.mjs",
    "check:urls": "node scripts/check-urls.mjs",
    "check:node-globals": "node scripts/check-node-globals.mjs",
    "check:keystore-boundary": "node scripts/check-keystore-boundary.mjs",
    "build:extension": "vite build --config extension/vite.config.ts",
    "check:bundle": "node extension/smoke/run.mjs",
    "check:package": "node scripts/check-extension-package.mjs",
    "check:readme": "node scripts/check-readme-claims.mjs",
    "check:i18n-keys": "node scripts/check-i18n-keys.mjs",
    "check:extension-host": "node scripts/check-extension-host.mjs"
  },
  "dependencies": {
    "@noble/hashes": "1.5.0",
    "@scure/bip39": "1.4.0",
    "@stricahq/bip32ed25519": "^1.1.2",
    "@stricahq/cbors": "^1.1.0",
    "@stricahq/typhonjs": "^3.1.1",
    "bech32": "^2.0.0",
    "bignumber.js": "^9.1.2",
    "buffer": "^6.0.3",
    "qrcode.react": "^4.2.0",
    "react": ">=18",
    "react-i18next": "^15.0.2"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "4",
    "i18next": "^26.4.0",
    "react-dom": "^19.2.8",
    "typescript": "^5",
    "vite": "6",
    "vitest": "^2.1.8"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
