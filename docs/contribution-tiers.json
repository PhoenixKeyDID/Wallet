{
  "version": 1,
  "notes": [
    "Maps repository paths to a contribution tier. Read by the contribution marketplace at a pinned commit.",
    "Rule 1: a file matching no glob is treated as forbidden.",
    "Rule 2: a pull request touching several tiers takes the highest one (low < mid < forbidden).",
    "Rule 3: the tier is never inferred from CODEOWNERS.",
    "Glob dialect: only *, ** and ? (no braces, no character classes, no negation), so every file name is listed as its own pattern.",
    "extension/ is listed per sub-path rather than as extension/**, because the highest tier wins and a wildcard would also forbid the one stylesheet that is low-risk."
  ],
  "tiers": {
    "low": [
      "locales/**",
      "src/components/Nav.tsx",
      "src/components/Footer.tsx",
      "src/components/CopyBtn.tsx",
      "extension/src/popup.css",
      "**/__tests__/**",
      "**/*.test.ts"
    ],
    "mid": [
      "src/lib/cardano/**",
      "src/components/wallet/**",
      "src/lib/api.ts",
      "src/lib/wallet.ts",
      "src/lib/night.ts",
      "src/lib/toast.ts",
      "src/components/night/**",
      "src/app/**",
      "README.md",
      "docs/**"
    ],
    "forbidden": [
      "src/lib/keystore/**",
      "extension/*",
      "extension/background/**",
      "extension/content/**",
      "extension/inpage/**",
      "extension/smoke/**",
      "extension/src/*.ts",
      "extension/src/*.tsx",
      "extension/src/rpc/**",
      "extension/src/__tests__/**",
      "src/lib/cardano/tx.ts",
      "src/lib/cardano/send.ts",
      "src/lib/cardano/connect.ts",
      "src/lib/cardano/cip30.ts",
      "src/lib/cardano/txSummary.ts",
      "src/lib/cardano/xpub.ts",
      "src/lib/cardano/address.ts",
      "src/lib/cardano/staking.ts",
      "src/lib/cardano/governance.ts",
      "src/lib/cardano/walletPort.ts",
      "src/lib/cardano/hash.ts",
      "src/lib/cardano/provider.ts",
      "src/lib/cardano/chainEnv.ts",
      "src/lib/cardano/blockfrost.ts",
      "src/lib/cardano/chainSource.ts",
      "src/lib/cardano/submitError.ts",
      "src/components/wallet/LocalWalletPanel.tsx",
      "src/components/wallet/ConfirmGate.tsx",
      "src/components/wallet/Cip30Panel.tsx",
      "src/components/wallet/SeedPhraseStep.tsx",
      "src/components/wallet/SendPanel.tsx",
      "src/lib/node-globals.ts",
      ".github/**",
      "scripts/**",
      "CODEOWNERS",
      "docs/contribution-tiers.json",
      "docs/host-contract.json",
      "package.json",
      "bun.lock",
      "tsconfig.json",
      "vitest.config.ts"
    ]
  }
}
